# Скопируйте этот файл в .env и подставьте свои значения.

# --- База данных (обязательно) ---
# Придумайте пароль: 16 символов латиницей и цифрами, без пробелов.
DB_PASSWORD=ПРИДУМАЙТЕ_ПАРОЛЬ

# При запуске через Docker эту строку менять НЕ НУЖНО — адрес базы
# соберётся сам из DB_PASSWORD выше. Строка нужна только для запуска
# без Docker: тогда впишите свой пароль и замените db:5432 на localhost:5432
DATABASE_URL=postgresql://fixkey:ПРИДУМАЙТЕ_ПАРОЛЬ@db:5432/fixkey

# --- Адрес сервера ---
HOST=0.0.0.0
PORT=8000

# С каких сайтов разрешён доступ. Впишите свой домен вместо *
CORS_ORIGIN=*

# --- Пароли сотрудников (ОБЯЗАТЕЛЬНО при переносе данных) ---
# Сюда впишите значение секрета AWS_SECRET_ACCESS_KEY со старой платформы,
# иначе после переезда никто не сможет войти со своим паролем.
# Если достать его не удалось — впишите любое значение, например
# fixkey_salt_new, и задайте себе новый пароль командой:
#   docker compose exec -T api python3 set-password.py ваша@почта.ru НовыйПароль
PASSWORD_SALT=

# --- Хранилище файлов (фото, планы, логотипы, подписи) ---
# Оставьте пустым, если файлы пока не нужны.
S3_ENDPOINT=
S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Почта для заявок с сайта ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=