{
  "tests": [
    {
      "name": "OPTIONS CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET without auth returns 401",
      "method": "GET",
      "path": "/?object_id=1",
      "expectedStatus": 401
    },
    {
      "name": "POST without auth returns 401",
      "method": "POST",
      "path": "/",
      "body": {"object_id": 1, "scheme": {}},
      "expectedStatus": 401
    }
  ]
}
